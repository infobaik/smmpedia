{
  "name": "smm-panel-honox",
  "version": "1.0.0",
  "description": "SMM Panel Enterprise dengan HonoX, D1, dan KV",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "deploy": "wrangler pages deploy dist",
    "db:init": "wrangler d1 execute smm_panel_db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute smm_panel_db --remote --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.2.0",
    "honox": "^0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "@hono/vite-build": "^1.0.0",
    "@hono/vite-dev-server": "^0.10.0",
    "vite": "^5.2.0",
    "wrangler": "^3.50.0"
  }
}
